# Copy to /etc/quic-affinity/agents/<agent-id>.env.
# qaffd must already be running for this listener.

QAFF_SOCKET=/run/quic-affinity/udp-ipv4-127.0.0.1-4433.sock
QAFF_TARGET_PID=12345
QAFF_WORKER_ID=0
QAFF_LISTEN_ADDRESS=127.0.0.1
QAFF_LISTEN_PORT=4433
QAFF_DISCOVERY_TIMEOUT_MS=10000
QAFF_HEARTBEAT_MS=1000
QAFF_SOCKET_CHECK_MS=250
