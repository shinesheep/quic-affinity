# Copy to /etc/quic-affinity/<listener-id>.env and replace the example
# listener id in the paths below.

QAFF_SOCKET=/run/quic-affinity/udp-ipv4-127.0.0.1-4433.sock
QAFF_BPF_OBJECT=/usr/libexec/quic-affinity/qaff_reuseport.bpf.o
QAFF_SHORT_CID_LEN=8
QAFF_FALLBACK_WORKER=0
# "kernel" keeps Linux's native SO_REUSEPORT 4-tuple distribution for
# unknown/Initial traffic. Use "fixed" for the legacy fixed-worker policy.
QAFF_FALLBACK_MODE=kernel
QAFF_WORKER_HEARTBEAT_TIMEOUT_MS=0
QAFF_PASSIVE_SCAN_INTERVAL_MS=30000
# cgroup v2 path used when passive egress learning is enabled.
QAFF_EGRESS_CGROUP=/sys/fs/cgroup
# Example: QAFF_EXTRA_ARGS=--allow-worker-gid 123 --allow-admin-gid 124
# Group socket access also requires --socket-mode 0660 --socket-gid GID and an
# explicit --allow-admin-uid and/or --allow-admin-gid management identity.
# Profile example: QAFF_EXTRA_ARGS=--cid-profile-v1-key-file /etc/quic-affinity/profile-v1.key
# EnvironmentFile values are not recursively expanded; repeat the cgroup path
# literally in QAFF_EXTRA_ARGS when enabling passive egress learning.
# Passive example: QAFF_EXTRA_ARGS=--passive-affinity --egress-cgroup /sys/fs/cgroup
QAFF_EXTRA_ARGS=
QAFF_PIN_ROOT=/sys/fs/bpf/quic-affinity/listeners/udp-ipv4-127.0.0.1-4433
QAFF_STATE_PATH=/var/lib/quic-affinity/udp-ipv4-127.0.0.1-4433.state
